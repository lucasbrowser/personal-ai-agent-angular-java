# Copie para .env na raiz do projeto e altere os valores.
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-local

DB_URL=jdbc:postgresql://localhost:5432/jarvis
DB_USERNAME=jarvis
DB_PASSWORD=change-me-local

SERVER_PORT=8080

# Use uma chave aleatória com pelo menos 32 bytes em ambientes locais.
JARVIS_JWT_SECRET=replace-with-at-least-32-random-bytes
JARVIS_ADMIN_EMAIL=admin@localhost
JARVIS_ADMIN_PASSWORD=replace-with-a-long-local-password
JARVIS_FRONTEND_ORIGIN=http://localhost:4200
JARVIS_SECURE_COOKIE=false

# Será utilizado na T-03. Nunca colocar a chave real no frontend.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
OPENAI_REALTIME_CONNECT_TIMEOUT=3s
OPENAI_REALTIME_RESPONSE_TIMEOUT=10s
JARVIS_VOICE_SESSIONS_PER_MINUTE=5
